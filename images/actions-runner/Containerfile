# syntax=docker/dockerfile:1.7

FROM rust:1-bookworm AS builder

WORKDIR /src

COPY images/actions-runner/runner-entrypoint-Cargo.toml ./Cargo.toml
COPY Cargo.lock ./
COPY src/bin/runlet-runner-entrypoint.rs ./src/bin/runlet-runner-entrypoint.rs
COPY src/runner_entrypoint.rs src/runner_entrypoint_process.rs ./src/

ARG TARGETARCH
RUN --mount=type=cache,id=runlet-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry \
    --mount=type=cache,id=runlet-cargo-target-${TARGETARCH},target=/src/target \
    mkdir -p /out \
    && cargo build --release --bin runlet-runner-entrypoint \
    && cp target/release/runlet-runner-entrypoint /out/runlet-runner-entrypoint

FROM debian:trixie-slim

ARG RUNNER_VERSION=2.334.0
ARG TARGETARCH=amd64

LABEL org.opencontainers.image.title="Runlet GitHub Actions runner" \
      org.opencontainers.image.description="GitHub Actions runner image for Runlet-managed ephemeral runners" \
      org.opencontainers.image.source="https://github.com/davidvornholt/runlet" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update \
    && apt-get install --no-install-recommends -y bash ca-certificates curl git jq libicu76 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /usr/sbin/nologin runner \
    && mkdir -p /actions-runner \
    && chown runner:runner /actions-runner

USER runner
WORKDIR /actions-runner

RUN case "${TARGETARCH}" in \
      amd64) runner_arch="x64" ;; \
      arm64) runner_arch="arm64" ;; \
      *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --show-error \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${runner_arch}-${RUNNER_VERSION}.tar.gz" \
      | tar --extract --gzip --no-same-owner

USER root
COPY --from=builder /out/runlet-runner-entrypoint /usr/local/bin/runlet-runner-entrypoint
RUN chmod 0755 /usr/local/bin/runlet-runner-entrypoint
USER runner

ENTRYPOINT ["/usr/local/bin/runlet-runner-entrypoint"]
